---
const stack = [
  "HTML", "CSS3", "Tailwind", "JavaScript", "Vue", "React", "Node.js",
  "SvelteKit", "TypeScript", "Django", "Axum", "PHP", "ESLint", "Prettier",
];
---
<section id="about" class="px-4 sm:px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <div class="reveal max-w-2xl">
      <h2 class="font-display font-bold text-4xl sm:text-5xl tracking-tight">About Me</h2>
      <p class="mt-5 text-lg text-ink/70 leading-relaxed">
        A closer look at my background, skills, and journey as a developer.
      </p>
    </div>

    <div class="mt-12 grid lg:grid-cols-[1.1fr_1fr] gap-12 items-start">
      <div class="reveal">
        <p class="text-lg text-ink/75 leading-relaxed">
          I'm <strong>Oluwafemi Waya</strong> — a Computer Science graduate from Federal University
          Oye-Ekiti, based in Ado-Ekiti, Nigeria. I build websites and web products for real
          businesses: hair stylists, event centres, dealerships, restaurants and more.
        </p>
        <p class="mt-5 text-lg text-ink/75 leading-relaxed">
          My approach is simple — understand the goal, design clean, ship fast, and write code
          that's easy to maintain. From pixel-perfect landing pages to full-stack apps with
          Node.js, Django, or SvelteKit, I care about the details that make products feel right.
        </p>
        <p class="mt-5 text-lg text-ink/75 leading-relaxed">
          When I'm not shipping client work, you'll find me sharpening my tools, contributing to
          open source, or helping people solve everyday tech problems.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="https://github.com/Bloody-noodles" target="_blank" rel="noopener" class="rounded-full bg-ink text-cream px-5 py-2.5 text-sm font-semibold hover:bg-tang transition-colors">GitHub ↗</a>
          <a href="https://www.linkedin.com/in/oluwafemi-waya-1219a13a2" target="_blank" rel="noopener" class="rounded-full border border-ink/15 bg-white px-5 py-2.5 text-sm font-semibold hover:border-tang hover:text-tang transition-colors">LinkedIn ↗</a>
        </div>
      </div>

      <div class="reveal">
        <h3 class="font-display font-bold text-xl mb-5">My toolbox</h3>
        <div class="flex flex-wrap gap-2.5">
          {stack.map((s) => (
            <span class="rounded-full bg-white border border-ink/12 px-4 py-2 text-sm font-medium hover:bg-lime hover:border-lime transition-colors cursor-default">{s}</span>
          ))}
        </div>
        <div class="mt-10 rounded-3xl bg-ink text-cream p-7">
          <h3 class="font-display font-bold text-xl">Education & experience</h3>
          <ul class="mt-5 space-y-4 text-sm text-cream/80">
            <li class="flex gap-3">
              <span class="text-lime font-display font-bold shrink-0">2022–26</span>
              <span>B.Sc. Computer Science — Federal University Oye-Ekiti (FUOYE)</span>
            </li>
            <li class="flex gap-3">
              <span class="text-lime font-display font-bold shrink-0">2022–now</span>
              <span>Freelance website developer — client sites across hospitality, auto, events & beauty</span>
            </li>
            <li class="flex gap-3">
              <span class="text-lime font-display font-bold shrink-0">2022–now</span>
              <span>Computer/Cybercafé assistant — customer-facing digital services & support</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="reveal mt-16 overflow-hidden rounded-3xl border border-ink/10 bg-white py-5">
      <div class="marquee-track">
        {[0, 1].map((n) => (
          <div class="flex shrink-0 items-center" aria-hidden={n === 1}>
            {stack.concat(stack).map((s) => (
              <span class="flex items-center gap-6 px-6 font-display font-bold text-xl whitespace-nowrap">
                {s}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-tang"><path d="M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.4-7.2L2 12l7.6-2.8z"/></svg>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
